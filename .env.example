# ═════════════════════════════════════════════════════════════════════════
# СУЛАК CRM — Конфигурация переменных окружения для сервера (Production / Dev)
# ═════════════════════════════════════════════════════════════════════════

# 1. Подключение к СУБД PostgreSQL (Локально или Сервер)
# Формат: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sulak_db"

# 2. Секретный ключ для подписи JWT-токенов авторизации (Смените на прод-сервере!)
JWT_SECRET="generate-at-least-32-random-characters"

# Ключ AES-шифрования секретов интеграций в system_settings.
# Храните отдельно от дампа БД и не меняйте без процедуры ротации.
SETTINGS_ENCRYPTION_KEY="generate-another-32-character-random-secret"

# Общий AES-ключ Server Actions между сборками/инстансами (base64, 32 байта).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# 3. Защита автоматических расписаний (Крон-задач)
# Обязателен на прод-сервере. Передается в заголовке Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-long-random-cron-secret"

# 4. Облачное хранилище изображений S3 (VK Cloud, Yandex Cloud, AWS, Selectel, MinIO)
# При заполнении этих переменных все загружаемые изображения идут напрямую в S3 Бакет!
S3_BUCKET_NAME="sulak-crm-uploads"
S3_REGION="ru-central1"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_PUBLIC_URL_PREFIX="https://storage.yandexcloud.net/sulak-crm-uploads"
# Установите true, если бакет не поддерживает Object ACL.
S3_DISABLE_ACL=false

# 5. Интеграция с Telegram-ботом алертов и уведомлений
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# 6. Порт запуска сервиса
PORT=3000

# 7. Авито API (мониторинг отзывов)
# Ключи аккаунтов хранятся в БД через Настройки → Авито · Отзывы
# Для получения Client ID и Client Secret: Авито → Настройки → Профессиональный раздел → API
AVITO_REVIEWS_ENABLED=true
